VITE_API_BASE_URL=https://api.staging.ohealthltd.com/

# Which dashboard to build/serve: mp-dashboard | ph-dashboard | lb-dashboard
# Aliases: mp | ph | lb. Defaults to mp-dashboard when unset.
VITE_ROUTE=mp
NODE_ENV=development
VITE_ENABLE_MSW=true

# Google OAuth Web client ID (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application). Must be the SAME client
# ID configured as GOOGLE_CLIENT_ID on the backend — it verifies the ID
# token's audience against it.
VITE_GOOGLE_CLIENT_ID=